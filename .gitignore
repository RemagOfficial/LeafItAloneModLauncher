# Build outputs (only if you compile in place)
*.obj
*.lib
*.exp
*.pdb
*.ilk
*.exe

# Created by install_overlay.ps1 (never commit)
.install_state
backup/

# Capture / editing scratch (dev only)
*.mkv
*.raw
*.log
*.tmp
take*/

# Python tooling (UnityPy etc. used by content-mods patches)
__pycache__/
*.pyc
.venv/
venv/

# Never commit game-derived content
mod-backups/
*.bak
*.bundle
*.bundle.backup
*.assets
*.resS
*.unity
catalog.bin

# Ad-hoc scratch folders devs drop next to a mod while diagnosing (may
# contain extracted .bundle files - never commit).
_scratch_*/
scratch/

# .NET launcher build output (never commit)
bin/
obj/
launcher/publish/
launcher/publish-selfcontained/
*.user

# Embedded/portable runtime staged at package time (huge; not source)
launcher/runtime/


# OS noise
Thumbs.db
[Dd]esktop.ini
.DS_Store
