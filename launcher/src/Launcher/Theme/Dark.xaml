<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        L9 dark palette. Same key set as Light.xaml (parity is asserted headless); only
        the values differ, which is what makes the swap safe. The console keeps a dark
        ground in both themes, so the fixed LogLineBrushConverter colors stay legible -
        but ConsoleBgBrush here is a touch deeper to sit into the dark window.
    -->

    <Color x:Key="AccentColor">#3FA34D</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#15181E" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E222A" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#101318" />
    <SolidColorBrush x:Key="DividerBrush" Color="#2A2F39" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E7EAEE" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B4BAC4" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7E8592" />

    <SolidColorBrush x:Key="ControlBorderBrush" Color="#333A45" />
    <SolidColorBrush x:Key="InputBgBrush" Color="#22262E" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#242A34" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4CB55C" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#358A42" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#6ED06E" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#F0B24A" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#F26D6D" />

    <SolidColorBrush x:Key="BannerBgBrush" Color="#332A12" />
    <SolidColorBrush x:Key="BannerFgBrush" Color="#F2CE6B" />
    <SolidColorBrush x:Key="BannerBorderBrush" Color="#6B5A22" />

    <SolidColorBrush x:Key="ChipBgBrush" Color="#4A3B12" />
    <SolidColorBrush x:Key="ChipFgBrush" Color="#F2CE6B" />

    <SolidColorBrush x:Key="ConsoleBgBrush" Color="#0F1216" />
    <SolidColorBrush x:Key="ConsoleFgBrush" Color="#D4D4D4" />

    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#3A414D" />

</ResourceDictionary>
