<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        L9 light palette. These are the ONLY raw colors in the app; every style in
        Controls.xaml binds to these keys by DynamicResource, so ThemeManager can swap
        this whole dictionary for Dark.xaml at runtime and nothing else changes. The
        AccentBrush / hover / pressed / on-accent entries are sane fallbacks - the
        runtime accent dictionary (built from the user's pick) is merged after this and
        wins. Keep the key set byte-for-byte identical to Dark.xaml (a headless check
        asserts the parity).
    -->

    <Color x:Key="AccentColor">#3FA34D</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EDEFF3" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E1E3E8" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4A5158" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8A9099" />

    <SolidColorBrush x:Key="ControlBorderBrush" Color="#D5D9E0" />
    <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#E4E7EC" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4CB55C" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#358A42" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#2E7D32" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#B26A00" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#C62828" />

    <SolidColorBrush x:Key="BannerBgBrush" Color="#FFF6E5" />
    <SolidColorBrush x:Key="BannerFgBrush" Color="#7A5C00" />
    <SolidColorBrush x:Key="BannerBorderBrush" Color="#E6B800" />

    <SolidColorBrush x:Key="ChipBgBrush" Color="#FFE9A8" />
    <SolidColorBrush x:Key="ChipFgBrush" Color="#7A5C00" />

    <SolidColorBrush x:Key="ConsoleBgBrush" Color="#1B1E24" />
    <SolidColorBrush x:Key="ConsoleFgBrush" Color="#D4D4D4" />

    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#C2C7CF" />

</ResourceDictionary>
