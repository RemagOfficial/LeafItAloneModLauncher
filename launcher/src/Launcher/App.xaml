<Application x:Class="LeafItAlone.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:LeafItAlone.Launcher.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!--
            L9 design system, merged in load order: Controls (styles, which read the
            palette keys by DynamicResource) then the light palette as the startup
            fallback. App.xaml.cs swaps the palette for the saved theme/accent before the
            window opens, so this default only shows for a fraction of a second.
            Shared converters live here so every view (and the MainWindow) resolves them
            from the application scope rather than redeclaring per window.
        -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theme/Controls.xaml" />
                <ResourceDictionary Source="/Theme/Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolVis" />
            <v:LogLineBrushConverter x:Key="LogLineBrush" />
            <v:EqualityConverter x:Key="Eq" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
