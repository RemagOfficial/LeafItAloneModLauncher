<Application x:Class="LeafItAlone.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Minimal shared palette; the UI grows in L2+ as pages are fleshed out. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#3FA34D" />
        <SolidColorBrush x:Key="PanelBrush" Color="#F5F5F7" />
        <SolidColorBrush x:Key="LogBrush" Color="#1E1E1E" />
    </Application.Resources>
</Application>
