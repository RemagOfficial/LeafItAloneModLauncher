<Window x:Class="LeafItAlone.Launcher.Views.TrustInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trust this source?" Height="440" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Install from an untrusted source?" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,8,0,12" TextWrapping="Wrap" Style="{StaticResource SecondaryText}"
                   Text="This launcher does not run the mod yet - it only copies its files to your disk. But once installed, pressing Apply runs the mod's scripts with your user privileges." />

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
            <StackPanel>
                <TextBlock Text="Source" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SourceUrl}" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                <TextBlock Text="Commit" FontWeight="SemiBold" Margin="0,10,0,0" />
                <TextBlock Text="{Binding SourceSha}" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontFamily="Consolas, Menlo, monospace" />
                <TextBlock Text="Mod" FontWeight="SemiBold" Margin="0,10,0,0" />
                <TextBlock Text="{Binding ModLine}" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                <TextBlock Text="Scripts this mod ships" FontWeight="SemiBold" Margin="0,10,0,0" />
                <ItemsControl ItemsSource="{Binding ScriptLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas, Menlo, monospace" FontSize="11" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,14,0,4" FontWeight="SemiBold"
                   Text="Type INSTALL below if you trust this source and want to continue." />
        <TextBox Grid.Row="4" Height="30" VerticalContentAlignment="Center" Padding="6,0"
                 Text="{Binding TypedWord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button Content="Install" Style="{StaticResource PrimaryButtonStyle}" Click="Ok_Click"
                    IsDefault="True"
                    IsEnabled="{Binding CanInstall}" />
        </StackPanel>
    </Grid>
</Window>
