<UserControl x:Class="LeafItAlone.Launcher.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Mod list: rounded selection + pending chip, driven straight from Editors. -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
            <ListBox ItemsSource="{Binding Editors}"
                     SelectedItem="{Binding SelectedEditor}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Mod.Name}" FontWeight="SemiBold" FontSize="13" />
                                <!-- Muted under the default card look, but must flip to the on-accent
                                     foreground when the row is selected (accent-green bg) or it goes
                                     unreadable - notably in dark mode. -->
                                <TextBlock Text="{Binding Mod.Version}" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                                    <Setter Property="Opacity" Value="0.85" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource ChipBgBrush}" CornerRadius="9"
                                    Padding="8,1" VerticalAlignment="Center"
                                    Visibility="{Binding IsPending, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="pending" FontSize="11" Foreground="{DynamicResource ChipFgBrush}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Detail pane: the schema-driven editor for the selected mod. -->
        <ScrollViewer Grid.Column="1" Margin="14,0,4,0" VerticalScrollBarVisibility="Auto"
                      DataContext="{Binding SelectedEditor}">
            <StackPanel>
                <TextBlock Text="{Binding Mod.Name}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Mod.Version}" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource SecondaryText}"
                           Text="{Binding Mod.Description}" />

                <CheckBox Margin="0,14,0,0" IsChecked="{Binding Enabled, Mode=TwoWay}"
                          Content="Enable this mod (all enabled mods reconcile on Apply &amp; Launch)" FontWeight="SemiBold" />

                <WrapPanel Margin="0,14,0,0">
                    <Button Content="Save config" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" />
                    <Button Content="Reload" Command="{Binding ReloadCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,8" />
                    <!-- Apply/Revert live on the MainViewModel; reach them via the window DataContext. -->
                    <Button Content="Apply to game" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                            Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Content="Revert" Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </WrapPanel>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}" Text="{Binding Info}" />

                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Config store" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" Style="{StaticResource MutedText}" Text="{Binding LivePath}" />
                        <TextBlock Text="Requires" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" Style="{StaticResource MutedText}" Text="{Binding Mod.RequiresSummary}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="2,10"
                                            Visibility="{Binding IsVisible, Converter={StaticResource BoolVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- label + tooltip (help) -->
                                            <StackPanel Grid.Column="0" ToolTip="{Binding Help}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                            </StackPanel>

                                            <!-- numeric: slider (safe band) + free-entry box -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="int">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="float">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Slider Width="220" VerticalAlignment="Center"
                                                        Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                        TickFrequency="{Binding Step}" IsSnapToTickEnabled="False"
                                                        Value="{Binding Num, Mode=TwoWay}" />
                                                <TextBox Width="96" Margin="12,0,0,0" VerticalAlignment="Center"
                                                         ToolTip="Any value except 0 (the slider stays within the safe range)"
                                                         Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                            </StackPanel>

                                            <!-- bool -->
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                      IsChecked="{Binding Bool, Mode=TwoWay}">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="bool">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>

                                            <!-- enum -->
                                            <ComboBox Grid.Column="1" Width="200" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      ItemsSource="{Binding Options}" SelectedItem="{Binding Str, Mode=TwoWay}">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="enum">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>

                                            <!-- text -->
                                            <TextBox Grid.Column="1" Width="260" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                     Text="{Binding Str, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="text">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
