<UserControl x:Class="LeafItAlone.Launcher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <!-- Segmented theme choice: a pill that fills with the accent when selected. -->
        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="16,7" Margin="0,0,8,0"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent swatch: a color disc with a selection ring when it matches the accent. -->
        <Style x:Key="AccentSwatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="30" Height="30">
                            <Ellipse Fill="{TemplateBinding Background}" />
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2"
                                     Margin="-4" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" Margin="4,2,10,4">

            <TextBlock Text="Launcher preferences" Style="{StaticResource PageTitle}" />
            <TextBlock Margin="0,4,0,16" Style="{StaticResource SecondaryText}"
                       Text="Appearance and path settings for the launcher itself. These persist to settings.json and take effect immediately - they never change what is applied to the game." />

            <!-- Appearance -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />

                    <TextBlock Margin="0,12,0,4" Text="Theme" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentRadio}" GroupName="theme" Content="Light"
                                     Command="{Binding SelectThemeCommand}" CommandParameter="light"
                                     IsChecked="{Binding ThemeChoice, Converter={StaticResource Eq}, ConverterParameter=light, Mode=OneWay}" />
                        <RadioButton Style="{StaticResource SegmentRadio}" GroupName="theme" Content="Dark"
                                     Command="{Binding SelectThemeCommand}" CommandParameter="dark"
                                     IsChecked="{Binding ThemeChoice, Converter={StaticResource Eq}, ConverterParameter=dark, Mode=OneWay}" />
                        <RadioButton Style="{StaticResource SegmentRadio}" GroupName="theme" Content="System"
                                     Command="{Binding SelectThemeCommand}" CommandParameter="system"
                                     IsChecked="{Binding ThemeChoice, Converter={StaticResource Eq}, ConverterParameter=system, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Margin="0,16,0,4" Text="Accent color" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource AccentSwatch}" Background="#3FA34D"
                                     ToolTip="Leaf green" Command="{Binding SelectAccentCommand}" CommandParameter="#3FA34D"
                                     IsChecked="{Binding AccentChoice, Converter={StaticResource Eq}, ConverterParameter=#3FA34D, Mode=OneWay}" />
                        <RadioButton Style="{StaticResource AccentSwatch}" Background="#0E9F9F"
                                     ToolTip="Teal" Command="{Binding SelectAccentCommand}" CommandParameter="#0E9F9F"
                                     IsChecked="{Binding AccentChoice, Converter={StaticResource Eq}, ConverterParameter=#0E9F9F, Mode=OneWay}" />
                        <RadioButton Style="{StaticResource AccentSwatch}" Background="#2E7BD6"
                                     ToolTip="Blue" Command="{Binding SelectAccentCommand}" CommandParameter="#2E7BD6"
                                     IsChecked="{Binding AccentChoice, Converter={StaticResource Eq}, ConverterParameter=#2E7BD6, Mode=OneWay}" />
                        <RadioButton Style="{StaticResource AccentSwatch}" Background="#6E56CF"
                                     ToolTip="Violet" Command="{Binding SelectAccentCommand}" CommandParameter="#6E56CF"
                                     IsChecked="{Binding AccentChoice, Converter={StaticResource Eq}, ConverterParameter=#6E56CF, Mode=OneWay}" />
                        <TextBox Width="110" Margin="12,0,0,0" VerticalAlignment="Center"
                                 ToolTip="Any #RRGGBB" Text="{Binding AccentChoice, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Paths -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Paths" Style="{StaticResource SectionTitle}" />

                    <!-- Content root -->
                    <TextBlock Margin="0,12,0,2" Text="Content root" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding RootPath}" />
                    <DockPanel Margin="0,8,0,0" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Browse…" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding BrowseContentRootCommand}" />
                            <Button Content="Auto" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding ClearContentRootCommand}" />
                        </StackPanel>
                        <TextBox Text="{Binding ContentRootOverride, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Leave blank to auto-detect (walk up from the executable)" />
                    </DockPanel>

                    <!-- Game exe -->
                    <TextBlock Margin="0,18,0,2" Text="Game executable" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="{Binding GameExeDisplay}" />
                    <DockPanel Margin="0,8,0,0" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Browse…" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding BrowseGameExeCommand}" />
                            <Button Content="Auto" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding ClearGameExeCommand}" />
                        </StackPanel>
                        <TextBox Text="{Binding GameExeOverride, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Leave blank to use the path the safe-base recorded" />
                    </DockPanel>

                    <Separator Margin="0,18" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8"
                               Text="Overrides only redirect the existing engines; nothing here patches or launches the game by itself." />
                    <Button Content="Reset all settings to defaults" Style="{StaticResource DangerButtonStyle}"
                            HorizontalAlignment="Left" Command="{Binding ResetSettingsCommand}" />
                </StackPanel>
            </Border>

            <!-- Mod sources (2a R4): list of GitHub repos the Browse tab fetches from. -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Mod sources" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="GitHub repositories the launcher can browse and install mods from. Removing a source does not delete already-installed files." />

                    <CheckBox Margin="0,0,0,10" FontWeight="SemiBold"
                              IsChecked="{Binding AllowNonDefaultSources, Mode=OneWay}"
                              Content="Allow installs from non-default sources"
                              ToolTip="Off = you can only browse the built-in RemagOfficial repo. Turning this on lets you add third-party repos below." />

                    <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                             MaxHeight="180" Margin="0,0,0,8"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Url}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                                            <Run Text="{Binding RefName, Mode=OneWay}" /><Run Text="  @  " /><Run Text="{Binding LastShortSha, Mode=OneWay}" /><Run Text="   fetched: " /><Run Text="{Binding LastFetched, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center" Background="{DynamicResource ChipBgBrush}" CornerRadius="9" Padding="8,1"
                                            Visibility="{Binding Trusted, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="trusted" FontSize="11" Foreground="{DynamicResource ChipFgBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Add" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding AddSourceCommand}" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewSourceUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="https://github.com/owner/repo (or owner/repo)" />
                            <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding NewSourceRef, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="branch or tag (optional)" />
                        </Grid>
                    </DockPanel>

                    <WrapPanel>
                        <Button Content="Refresh all" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,4"
                                Command="{Binding RefreshSourcesCommand}" />
                        <Button Content="Remove selected" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,4"
                                Command="{Binding RemoveSourceCommand}" />
                        <Button Content="Open remote-mods folder" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,4"
                                Command="{Binding OpenRemoteModsFolderCommand}"
                                ToolTip="Delete an installed mod by hand: browse to its folder here and remove it." />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="The launcher never deletes mod files. Delete the folder in remote-mods/&lt;sourceKey&gt;/&lt;modId&gt;/ if you want to remove a mod; it will re-download automatically the next time you press Apply." />
                </StackPanel>
            </Border>

            <!-- About & maintenance (2b): the app version (single source: the assembly) and the
                 one-click diagnostics bundle. The exporter provably refuses every game file. -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="About &amp; maintenance" Style="{StaticResource SectionTitle}" />
                    <TextBlock Margin="0,6,0,0" FontSize="13">
                        <Run Text="Leaf it Alone Mod Launcher" /><Run Text="  ·  version " /><Run Text="{Binding AppVersion, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="If something misbehaves, export a diagnostics bundle to send with a bug report. It collects the launcher's settings, state, per-mod configs and the remote mod manifests - and never any game files (bundles, catalog.bin or backups are refused by design)." />
                    <Button Content="Export diagnostics" Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left" Command="{Binding ExportDiagnosticsCommand}"
                            ToolTip="Writes a zip to the launcher's diagnostics folder and opens it." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
