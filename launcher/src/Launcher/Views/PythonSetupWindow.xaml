<Window x:Class="LeafItAlone.Launcher.Views.PythonSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up the mod engine runtime"
        Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        TextElement.FontFamily="{DynamicResource AppFont}">
    <StackPanel Margin="22">
        <TextBlock Text="This launcher needs Python 3.12 with UnityPy to patch mods."
                   FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="StatusLine" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource StatusErrorBrush}" />

        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16">
            <StackPanel>
                <TextBlock Text="1. Install Python 3.12 (64-bit)" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryText}"
                           Text="Download and run the installer, and on the first screen tick 'Add python.exe to PATH'. The default C:\Python312 location is what the launcher looks for." />
                <TextBlock Margin="0,8,0,0">
                    <Hyperlink x:Name="DownloadLink" NavigateUri="https://www.python.org/downloads/windows/"
                               RequestNavigate="OnNavigate">python.org/downloads/windows</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
            <StackPanel>
                <TextBlock Text="2. Add UnityPy" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryText}"
                           Text="Open a terminal (Command Prompt or PowerShell) and run this once:" />
                <DockPanel Margin="0,8,0,0" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource SecondaryButtonStyle}"
                            Margin="8,0,0,0" Click="OnCopy" />
                    <TextBox x:Name="PipBox" IsReadOnly="True" FontFamily="{DynamicResource MonoFont}"
                             VerticalContentAlignment="Center" Padding="8,5" />
                </DockPanel>
                <TextBlock Margin="0,12,0,0" Style="{StaticResource MutedText}"
                           Text="Python somewhere else? Set a LEAF_PYTHON environment variable to the full python.exe path and click Re-check. You do not need to restart the launcher." />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" IsCancel="True" Click="OnClose" />
            <Button Content="Re-check" Style="{StaticResource PrimaryButtonStyle}" Click="OnRecheck" />
        </StackPanel>
    </StackPanel>
</Window>
