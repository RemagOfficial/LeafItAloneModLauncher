<Window x:Class="LeafItAlone.Launcher.Views.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="560" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Margin="0,4,0,12" Style="{StaticResource MutedText}"
                   Text="Thanks for updating. Here is what is new in this release." />

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
            <!-- The release body is GitHub-flavoured markdown, rendered to a themed
                 FlowDocument by MarkdownRenderer (no NuGet dependency). Selectable so the
                 user can copy from it; links open in the default browser. -->
            <FlowDocumentScrollViewer x:Name="Body"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsSelectionEnabled="True"
                                      Background="Transparent"
                                      Foreground="{DynamicResource TextPrimaryBrush}" />
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Got it" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
