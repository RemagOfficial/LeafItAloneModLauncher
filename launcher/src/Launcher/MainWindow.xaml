<Window x:Class="LeafItAlone.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Leaf it Alone Mod Launcher" Height="640" Width="960"
        WindowStartupLocation="CenterScreen">
    <DockPanel LastChildFill="True">

        <!-- Status bar (dock bottom, above the log drawer) -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Shared output log drawer (plan: streams each subprocess's stdout/stderr) -->
        <Expander DockPanel.Dock="Bottom" Header="Output" IsExpanded="True">
            <ListBox Height="150" FontFamily="Consolas" FontSize="12"
                     Background="{StaticResource LogBrush}" Foreground="#D4D4D4"
                     ItemsSource="{Binding LogLines}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </Expander>

        <!-- Root path strip -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Content root: " FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding RootPath}" VerticalAlignment="Center"
                           Foreground="Gray" TextTrimming="CharacterEllipsis" MaxWidth="700" />
            </StackPanel>
        </Border>

        <TabControl Margin="8">
            <!-- Dashboard: lifecycle + the big apply/launch button arrive in L3-L5.
                 For L1 it shows wiring and runs the runner self-test. -->
            <TabItem Header="Dashboard">
                <StackPanel Margin="16">
                    <TextBlock Text="Welcome" FontSize="20" FontWeight="Bold" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#444"
                               Text="This launcher manages Leaf it Alone mods and the safe-base by driving the already-tested PowerShell + UnityPy engines. Install / Repair / Apply &amp; Launch land in later milestones." />
                    <Separator Margin="0,16" />
                    <WrapPanel>
                        <Button Content="Rescan mods" Command="{Binding RescanCommand}"
                                Padding="14,6" Margin="0,0,8,0" />
                        <Button Content="Test output runner" Command="{Binding DemoRunnerCommand}"
                                Padding="14,6" Background="{StaticResource AccentBrush}" Foreground="White" />
                    </WrapPanel>
                    <TextBlock Margin="0,10,0,0" Foreground="Gray" TextWrapping="Wrap"
                               Text="'Test output runner' proves the subprocess pipeline by running a harmless PowerShell one-liner - it does not touch the game." />
                </StackPanel>
            </TabItem>

            <!-- Mods: read-only discovery list + a detail pane describing the manifest. -->
            <TabItem Header="Mods">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0" ItemsSource="{Binding Mods}"
                             SelectedItem="{Binding SelectedMod}"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" />
                                    <TextBlock Text="{Binding Version}" Foreground="Gray" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ScrollViewer Grid.Column="1" Margin="12,4" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedMod.Name}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding SelectedMod.Version}" Foreground="Gray" />
                            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="{Binding SelectedMod.Description}" />

                            <TextBlock Margin="0,14,0,2" Text="Config store" FontWeight="Bold" />
                            <TextBlock TextWrapping="Wrap" Foreground="#333"
                                       Text="{Binding SelectedMod.Manifest.ConfigPath}" />

                            <TextBlock Margin="0,14,0,2" Text="Requires" FontWeight="Bold" />
                            <TextBlock TextWrapping="Wrap" Foreground="#333"
                                       Text="{Binding SelectedMod.RequiresSummary}" />

                            <TextBlock Margin="0,14,0,2" Text="Editable fields (schema-driven editor lands in L2)" FontWeight="Bold" />
                            <ItemsControl ItemsSource="{Binding SelectedMod.Manifest.Config.Fields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="2,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" FontWeight="Bold" MinWidth="140" />
                                                <TextBlock Text="{Binding Key}" Foreground="Gray" MinWidth="130" />
                                                <TextBlock Text="{Binding Type}" Foreground="Gray" MinWidth="60" />
                                                <TextBlock Text="{Binding Default}" Foreground="Gray" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Settings: paths shown; editing/wiring in later milestones. -->
            <TabItem Header="Settings">
                <StackPanel Margin="16">
                    <TextBlock Text="Settings" FontSize="18" FontWeight="Bold" />
                    <TextBlock Margin="0,10,0,0" Text="Content root:" FontWeight="Bold" />
                    <TextBlock Text="{Binding RootPath}" TextWrapping="Wrap" Foreground="#333" />
                    <TextBlock Margin="0,10,0,0" Foreground="Gray"
                               Text="Game path, bundled runtime and log folder settings are configured here in L5+." />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
