<Window x:Class="LeafItAlone.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:LeafItAlone.Launcher.Views"
        Title="Leaf it Alone Mod Launcher" Height="720" Width="1080"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="222" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ NAV RAIL ============ -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">

                <!-- brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,20,22">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="L" FontWeight="Bold" FontSize="16"
                                   Foreground="{DynamicResource OnAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Leaf it Alone" FontWeight="Bold" FontSize="14" />
                        <TextBlock Text="Mod Launcher" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- pages -->
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItemStyle}" GroupName="nav"
                             Content="&#xE80F;" Tag="Dashboard"
                             Command="{Binding SelectSectionCommand}" CommandParameter="Dashboard"
                             IsChecked="{Binding IsDashboardChecked, Mode=OneWay}" />
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItemStyle}" GroupName="nav"
                             Content="&#xE8FD;" Tag="Mods"
                             Command="{Binding SelectSectionCommand}" CommandParameter="Mods"
                             IsChecked="{Binding IsModsChecked, Mode=OneWay}" />
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItemStyle}" GroupName="nav"
                             Content="&#xE713;" Tag="Settings"
                             Command="{Binding SelectSectionCommand}" CommandParameter="Settings"
                             IsChecked="{Binding IsSettingsChecked, Mode=OneWay}" />

                <!-- footer: busy hint -->
                <Border DockPanel.Dock="Bottom" Margin="16,0,16,16">
                    <TextBlock Text="Working…" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                </Border>
            </DockPanel>
        </Border>

        <!-- ============ CONTENT ============ -->
        <DockPanel Grid.Column="1" LastChildFill="True">

            <!-- header band -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="22,16">
                <Grid>
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="9" Padding="10,3" Margin="0,0,8,0"
                                Visibility="{Binding HasPending, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding PendingCount, StringFormat={}{0} pending}"
                                       FontSize="12" Foreground="{DynamicResource ChipFgBrush}" />
                        </Border>
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9" Padding="10,3">
                            <TextBlock Text="{Binding Editors.Count, StringFormat={}{0} mod(s)}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- status bar (bottom-most) -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="18,7">
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- output console (above the status bar) -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource ConsoleBgBrush}">
                <StackPanel>
                    <DockPanel Margin="14,8" LastChildFill="False">
                        <ToggleButton x:Name="ConsoleToggle" DockPanel.Dock="Left" IsChecked="True"
                                      Content="Output" Style="{StaticResource ConsoleToggleStyle}" />
                        <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource GhostButtonStyle}"
                                Foreground="{DynamicResource ConsoleFgBrush}" Padding="10,2"
                                Command="{Binding ClearLogCommand}" />
                    </DockPanel>
                    <ListBox Height="150" Visibility="{Binding IsChecked, ElementName=ConsoleToggle, Converter={StaticResource BoolVis}}"
                             FontFamily="{DynamicResource MonoFont}" FontSize="12"
                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ConsoleFgBrush}"
                             ItemsSource="{Binding LogLines}"
                             v:LogAutoScroll.Enabled="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                           Foreground="{Binding Converter={StaticResource LogLineBrush}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- page region (fills) -->
            <Grid>
                <v:DashboardView Margin="22,18" Visibility="{Binding ShowDashboard, Converter={StaticResource BoolVis}}" />
                <v:ModsView Margin="22,18" Visibility="{Binding ShowMods, Converter={StaticResource BoolVis}}" />
                <v:SettingsView Margin="22,18" Visibility="{Binding ShowSettings, Converter={StaticResource BoolVis}}" />
            </Grid>
        </DockPanel>
    </Grid>
</Window>
