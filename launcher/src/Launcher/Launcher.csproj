<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Leaf it Alone Mod Launcher (plan L1).
    .NET 8 WPF, self-contained publish so public mod users need no .NET install.
    The app never reimplements the safety-critical engines; it orchestrates the
    existing PowerShell SDK + UnityPy patchers as subprocesses (see Services/ProcessRunner.cs)
    and drives mods purely from their content-mods/<id>/mod.json manifests.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LeafItAlone.Launcher</RootNamespace>
    <AssemblyName>LeafItAloneLauncher</AssemblyName>
    <!-- 2b: single source of truth for the app version (read by Services/AppInfo and
         compared against GitHub releases for the self-update check). Keep this equal
         to the latest released tag; bump it when a release is cut. -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>

    <!-- No external NuGet packages: System.Text.Json ships with the framework,
         so the project restores/builds fully offline. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- NOTE: do NOT set InvariantGlobalization here. WPF bindings call
         XmlLanguage.GetSpecificCulture(), which throws
         "Cannot find non-neutral culture related to 'en-us'" under the
         invariant globalization mode (no ICU culture data). -->
    <!-- Deterministic, self-contained single-file friendly defaults. -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
  </PropertyGroup>

</Project>
